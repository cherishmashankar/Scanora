<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0D0F" />
        </shape>
    </item>

    <!-- Soft inner panel -->
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#15151A" />
            <stroke
                android:width="1dp"
                android:color="#24242B" />
        </shape>
    </item>

    <!-- Subtle center glow -->
    <item
        android:left="22dp"
        android:top="38dp"
        android:right="22dp"
        android:bottom="38dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#001A1A1A"
                android:centerColor="#403F1A66"
                android:endColor="#001A1A1A" />
        </shape>
    </item>

</layer-list>